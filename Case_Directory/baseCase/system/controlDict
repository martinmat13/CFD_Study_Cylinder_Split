FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

#include        "geometryProperties"
#include        "../0/include/initialConditions"
// PLACEHOLDERS (replaced by runCases.sh):
//   SOLVER_NAME   -> simpleFoam | pimpleFoam
//   END_TIME      -> simulation end time
//   DELTA_T       -> time step size
//   WRITE_INTERVAL-> write interval

application     pimpleFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         10;
deltaT          0.001;
writeControl    timeStep;
writeInterval   #calc "1/(10*$deltaT)"; // write every 0.1 seconds
purgeWrite      0;
writeFormat     ascii;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable yes;
maxCo           0.5;
adjustTimeStep  no;

functions
{
    inMassFlow
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        enabled         true;
        writeControl    timeStep;
        writeInterval   100;
        writeFields     false;
        log             false;
        regionType      patch;
        name            inlet;
        operation       sum;
        fields
        (
            phi         // volumetric flux (will be NEGATIVE at inlet)
        );
    }

    outMassFlow
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        enabled         true;
        writeControl    timeStep;
        writeInterval   100;
        writeFields     false;
        log             false;
        regionType      patch;
        name            outlet;
        operation       sum;
        fields
        (
            phi
        );
    }

    minmaxdomain
    {
        type            fieldMinMax;
        libs            ("libfieldFunctionObjects.so");
        enabled         true;
        writeControl    timeStep;
        writeInterval   100;
        log             false;
        mode            component;
        fields          (p U k omega);
    }

    solverInfo
    {
        type            solverInfo;
        libs            ("libutilityFunctionObjects.so");
        enabled         true;
        writeControl    timeStep;
        writeInterval   10;
        fields          (U p k omega);
        writeResidualFields no;
    }

    forceCoeffs
    {
        type            forceCoeffs;
        libs            ("libforces.so");
        enabled         true;
        writeControl    timeStep;
        writeInterval   1;
        timeStart       0.0;
        timeEnd         $endTime;
        patches         ("cylinder");

        p               p;
        U               U;
        rho             rhoInf;
        rhoInf          1.225; // Density of air at 20°C in kg/m^3

        CofR            (0 0 0);
        liftDir         (0 1 0);
        dragDir         (1 0 0);
        pitchAxis       (0 0 1);

        magUInf         INLET_U;
        lRef            $l_Ref;
        Aref            $A_Ref;

        log             false;
    }

    yPlus
    {
        type            yPlus;
        libs            ("libfieldFunctionObjects.so");
        enabled         true;
        executeControl  timeStep;
        executeInterval 100;
        writeControl    timeStep;
        writeInterval   #calc "1/(10*$deltaT)";
        log             true;
        patches
        (
            cylinder
        );
    }

    wallShearStress
    {
        type            wallShearStress;
        libs            ("libfieldFunctionObjects.so");
        enabled         true;
        writeControl    timeStep;
        writeInterval   #calc "1/(10*$deltaT)";
        patches
        (
            cylinder
        );
    }

    
};
