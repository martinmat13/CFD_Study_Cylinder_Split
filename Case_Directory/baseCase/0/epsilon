FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// NOTE: Epsilon is NOT USED in k-omega SST model
// Kept for reference/compatibility with k-epsilon switching templates
// SST solves k and omega only; epsilon derived post-processing if needed
// epsilon = C_mu * k * omega (for output purposes)

dimensions      [0 2 -3 0 0 0 0];

#include "include/turbulenceInit"

internalField   uniform $epsilon_0;

boundaryField
{
    inlet
    {
        type        fixedValue;
        value       uniform $epsilon_0;
    }

    outlet
    {
        type        zeroGradient;
    }

    cylinder
    {
        type        epsilonWallFunction;
        value       uniform 0;
    }

    topAndBottom
    {
        type        slip;
    }


    frontAndBack
    {
        type        slip;
    }
}

