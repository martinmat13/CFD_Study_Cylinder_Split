FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nuTilda;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

#include "include/turbulenceInit"

internalField   uniform $nuTilda_0;

boundaryField
{
    inlet
    {
        type        fixedValue;
        value       uniform $nuTilda_0;
    }

    outlet
    {
        type        zeroGradient;
    }

    cylinder
    {
        type        zeroGradient;
    }

    topAndBottom
    {
        type        slip;
    }
    

    frontAndBack
    {
        type        slip;
    }
}

