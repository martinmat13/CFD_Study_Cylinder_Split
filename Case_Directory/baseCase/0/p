FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//For incompressible solvers (simpleFoam, pimpleFoam) pressure is kinematic pressure
dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
	type            zeroGradient;
    }

    outlet
    {
    type            fixedValue;
    value           uniform 0;
    }
    
    cylinder
    {
	type		zeroGradient;
    }

	topAndBottom
    {    
	type		slip;
    }

	frontAndBack
    {
    type        slip;
    }
}

