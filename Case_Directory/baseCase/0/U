FoamFile //2d
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (INLET_U 0 0);

boundaryField
{
    inlet
    {
        type        fixedValue;
        value       uniform (INLET_U 0 0);
    }

    outlet
    {
        type        zeroGradient;
    }

    cylinder
    {
        type        noSlip;
    }

    topAndBottom
    {
        type        slip;
    }

    frontAndBack
    {
        type        slip;
    }
}

